---
import Layout from "../layouts/Layout.astro";
import { client, urlFor } from '../lib/sanity';
const { slug } = Astro.params;

const logoetos = `*[_type == "media" && slug.current == "logo"][0] {
  title,
  "imageUrl": image.asset->url,
  alt
}`;

const logoIcon = await client.fetch(logoetos, { slug });
---
<!-- footer -->
 <footer class="bg-[#f2f4f5] dark:bg-slate-950 pt-24 pb-12 border-t border-[#e3bebb]/15">
<div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-7xl mx-auto px-8">
<div class="col-span-1 md:col-span-1">
<div class="w-[180px] h-12 mb-8">
     {logoIcon.imageUrl && (
    <img
        src={logoIcon.imageUrl} 
        alt={logoIcon?.alt || "Etos Jaya Utama"}
        />
    )}
</div>
<p class="text-secondary dark:text-slate-500 font-brand text-sm uppercase tracking-wider leading-relaxed mb-8">
                    Memberikan keunggulan teknis dan presisi operasional untuk kemajuan industri nasional.
                </p>
