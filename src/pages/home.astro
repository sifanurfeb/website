<script>
  function initCounters() {
    const counters = document.querySelectorAll('.counter');
    
    // Fungsi untuk menganimasikan angka
    const animateCounter = (counter) => {
      const target = +counter.getAttribute('data-target');
      const suffix = counter.getAttribute('data-suffix') || '';
      
      // Kecepatan animasi (semakin besar angka, semakin lambat)
      const speed = 200; 
      
      const updateCount = () => {
        // Ambil angka saat ini (bersihkan karakter non-angka jika ada)
        const currentCount = +counter.innerText.replace(/\D/g, '');
        
        // Hitung increment (penambahan per frame)
        const inc = target / speed;

        if (currentCount < target) {
          // Jika belum mencapai target, tambahkan angkanya
          counter.innerText = Math.ceil(currentCount + inc) + suffix;
          // Panggil lagi fungsi ini dalam waktu dekat
          setTimeout(updateCount, 10);
        } else {
          // Jika sudah selesai, pastikan angkanya pas dengan target
          counter.innerText = target + suffix;
        }
      };
      
      updateCount();
    };

    // Konfigurasi Observer
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.5 // Trigger aktif ketika 50% bagian card terlihat di layar
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const counter = entry.target;
        const suffix = counter.getAttribute('data-suffix') || '';

        if (entry.isIntersecting) {
          // 1. Jika card masuk ke layar, mulai animasi dari 0
          counter.innerText = '0' + suffix; 
          animateCounter(counter);
        } else {
          // 2. Jika card keluar dari layar, reset ke 0 secara diam-diam
          counter.innerText = '0' + suffix;
        }
      });
    }, observerOptions);

    // Pantau semua elemen yang memiliki class .counter
    counters.forEach(counter => {
      observer.observe(counter);
    });
  }

  // Inisialisasi saat DOM sudah siap diload
  document.addEventListener('DOMContentLoaded', initCounters);

  // WAJIB DITAMBAHKAN JIKA ANDA MENGGUNAKAN ASTRO VIEW TRANSITIONS
  document.addEventListener('astro:page-load', initCounters);
</script>